# Normalize line endings: store as LF, checkout as native
* text=auto
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.toml text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
.env.example text eol=lf

# Binary files -- no line ending conversion
*.pkl binary
*.joblib binary
*.h5 binary
*.png binary
*.jpg binary
*.pdf binary
*.faiss binary